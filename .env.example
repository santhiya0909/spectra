# ============================================================
# SPECTRA – Intelligent Educational System Environment Variables
# ============================================================
# Copy this file to .env and configure with your actual values.
# NEVER commit the actual .env file with sensitive credentials.

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/spectra_db

# Security & Authentication
# Generate a strong 256-bit secret key, e.g.: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_change_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Tutor Configuration
# Optional: If unset or invalid, the system automatically uses the built-in Intelligent Fallback Socratic Tutor
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# CORS & Server Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Frontend Public API URL (Accessible from client browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
